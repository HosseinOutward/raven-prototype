#!/bin/bash
# Installs the nftables table "inet raven_fw" atomically. Safe to run again at any time.
#   input   : default deny; SSH, DHCP, ICMP only.
#   forward : traffic that arrives on the uplink and is DNATed into a container. Docker
#             publishes ports in its own chains and bypasses INPUT, so this is where they
#             are really filtered. ct original proto-dst is the port as the client sent it.
#             80/tcp only from ArvanCloud's CDN ranges, 7881/tcp and the 50002-50100/udp
#             media range from anywhere, everything else dropped.
# Docker never touches this table, so a Docker restart leaves it alone.
set -euo pipefail
uplink=eth0
list=/etc/raven-firewall/arvan-ips.txt
elements=$(grep -E '^[0-9]+\.[0-9]+\.[0-9]+\.[0-9]+/[0-9]+$' "$list" | paste -sd, -)
[ -n "$elements" ] || { echo "no CDN ranges in $list" >&2; exit 1; }
tmp=$(mktemp)
cat > "$tmp" <<RULES
table inet raven_fw
delete table inet raven_fw
table inet raven_fw {
  set arvan4 {
    type ipv4_addr
    flags interval
    elements = { $elements }
  }
  chain input {
    type filter hook input priority filter; policy drop;
    ct state established,related accept
    ct state invalid drop
    iif lo accept
    icmp type { echo-request, destination-unreachable, time-exceeded, parameter-problem } limit rate 20/second accept
    icmpv6 type { destination-unreachable, packet-too-big, time-exceeded, parameter-problem, echo-request, nd-router-solicit, nd-router-advert, nd-neighbor-solicit, nd-neighbor-advert } limit rate 20/second accept
    udp dport 68 accept
    tcp dport 22 accept
  }
  chain forward {
    type filter hook forward priority -10; policy accept;
    iifname != "$uplink" accept
    ct state established,related accept
    meta l4proto tcp ct original proto-dst 80 ip saddr @arvan4 accept
    meta l4proto tcp ct original proto-dst 7881 accept
    meta l4proto udp ct original proto-dst 50002-50100 accept
    counter drop
  }
}
RULES
nft -c -f "$tmp"
nft -f "$tmp"
rm -f "$tmp"
