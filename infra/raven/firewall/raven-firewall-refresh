#!/bin/bash
# Weekly: fetch ArvanCloud's published CDN ranges, sanity check, reapply the firewall.
# On any doubt it keeps the list it has.
set -euo pipefail
url=https://www.arvancloud.ir/en/ips.txt
list=/etc/raven-firewall/arvan-ips.txt
new=$(mktemp)
trap 'rm -f "$new"' EXIT
curl -fsS --max-time 30 "$url" | tr -d '\r' | grep -E '^[0-9]+\.[0-9]+\.[0-9]+\.[0-9]+/[0-9]+$' > "$new" || true
n=$(wc -l < "$new")
if [ "$n" -lt 5 ] || awk -F/ '$2 < 16 { bad=1 } END { exit !bad }' "$new"; then
  echo "refusing the fetched list ($n entries)" >&2; exit 1
fi
if ! cmp -s "$new" "$list"; then
  install -m 644 "$new" "$list"
  /usr/local/sbin/raven-firewall-apply
  echo "CDN ranges updated ($n entries)"
fi
