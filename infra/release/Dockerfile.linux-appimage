FROM ubuntu:22.04@sha256:0e0a0fc6d18feda9db1590da249ac93e8d5abfea8f4c3c0c849ce512b5ef8982

ARG RUST_TOOLCHAIN=1.96.0
ARG TAURI_CLI_VERSION=2.11.2

ENV DEBIAN_FRONTEND=noninteractive
ENV RUSTUP_HOME=/opt/rustup
ENV CARGO_HOME=/opt/cargo-bootstrap
ENV PATH=/opt/cargo-bootstrap/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin

RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    ca-certificates \
    clang \
    cmake \
    curl \
    file \
    git \
    libasound2-dev \
    libayatana-appindicator3-dev \
    libclang-dev \
    libgstreamer-plugins-base1.0-dev \
    libgstreamer1.0-dev \
    libgtk-3-dev \
    libpipewire-0.3-dev \
    librsvg2-dev \
    libssl-dev \
    libwebkit2gtk-4.1-dev \
    meson \
    nasm \
    ninja-build \
    patchelf \
    pkg-config \
    wget \
    xdg-utils \
    yasm \
    && rm -rf /var/lib/apt/lists/*

RUN curl --proto '=https' --tlsv1.2 --fail --silent --show-error https://sh.rustup.rs -o /tmp/rustup-init.sh \
    && sh /tmp/rustup-init.sh -y --profile minimal --default-toolchain ${RUST_TOOLCHAIN} \
    && rm /tmp/rustup-init.sh \
    && cargo install tauri-cli --version ${TAURI_CLI_VERSION} --locked \
    && install -m 0755 /opt/cargo-bootstrap/bin/cargo-tauri /usr/local/bin/cargo-tauri \
    && rustc --version \
    && cargo-tauri --version

ENV CARGO_HOME=/cargo-cache
ENV APPIMAGE_EXTRACT_AND_RUN=1

