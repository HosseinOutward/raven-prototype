# Copy to .env and fill in. Generate each secret with: openssl rand -hex 32

# Database password. Choose it before the first start; changing it later needs a manual ALTER USER.
POSTGRES_PASSWORD=change-me
# LiveKit key pair used by the API to sign call tokens.
LIVEKIT_API_KEY=change-me
LIVEKIT_API_SECRET=change-me
# This machine's public IP address, advertised to call participants.
LIVEKIT_NODE_IP=203.0.113.10
# Public WebSocket address of LiveKit, as clients reach it through your proxy.
LIVEKIT_URL=wss://rtc.example.org
# Clients older than this version are asked to update. 0.1.0 accepts every release.
RAVEN_MINIMUM_CLIENT_VERSION=0.1.0
# Name and description shown on the sign-in screen.
RAVEN_SERVER_NAME=Raven
RAVEN_SERVER_DESCRIPTION=A Raven server
# Image version to run: latest, or a pinned release such as 0.1.6.
RAVEN_IMAGE_TAG=latest
