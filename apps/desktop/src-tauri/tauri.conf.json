{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Raven",
  "version": "0.1.0",
  "identifier": "app.raven.desktop",
  "build": {
    "beforeDevCommand": "bun run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "bun run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Raven",
        "width": 1280,
        "height": 820,
        "minWidth": 980,
        "minHeight": 700,
        "decorations": false,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "targets": "all",
    "externalBin": [],
    "icon": [
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDEwRTMzMjMzNUFEMTczQTIKUldTaWM5RmFNekxqRUluWjlHR2NSR3BXb3ZEVHVxWTdPS2c4bU5OcE1MalBBdDRydkJwNTZwVmgK",
      "endpoints": [
        "https://updates.rvn.bluehour.cloud/v1/updates/check/{{target}}/{{arch}}/{{current_version}}"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
